  <script>
    /* ==========================================
       CANVAS HEART ANIMATION SYSTEM (Black & Green)
       ========================================== */
    const canvas = document.getElementById('heartCanvas');
    const ctx = canvas.getContext('2d');

    // Canvas size
    const size = Math.min(window.innerWidth - 32, 380);
    canvas.width = size;
    canvas.height = size;

    let time = 0;
    let particles = [];
    let isUnlocked = false;

    // Mathematical Parametric Heart Formula
    function getHeartPoint(t, scale = 1) {
      // Standard heart equation scaled and inverted Y for canvas coordinate system
      const x = 16 * Math.pow(Math.sin(t), 3);
      const y = -(13 * Math.cos(t) - 5 * Math.cos(2*t) - 2 * Math.cos(3*t) - Math.cos(4*t));
      return {
        x: x * scale,
        y: y * scale
      };
    }

    // Floating Green Particle Class
    class HeartParticle {
      constructor() {
        this.reset();
      }
      reset() {
        const t = Math.random() * Math.PI * 2;
        const pt = getHeartPoint(t, size / 35);
        this.x = canvas.width / 2 + pt.x;
        this.y = canvas.height / 2 + pt.y;
        this.vx = (Math.random() - 0.5) * 1.5;
        this.vy = (Math.random() - 0.5) * 1.5 - 0.8;
        this.size = Math.random() * 2 + 1;
        this.alpha = Math.random() * 0.8 + 0.2;
        this.life = 0;
        this.maxLife = Math.random() * 60 + 40;
      }
      update() {
        this.x += this.vx;
        this.y += this.vy;
        this.life++;
        this.alpha -= 0.015;
        if (this.life >= this.maxLife || this.alpha <= 0) {
          this.reset();
        }
      }
      draw(context) {
        context.save();
        context.globalAlpha = Math.max(0, this.alpha);
        context.fillStyle = '#00ff66';
        context.shadowBlur = 8;
        context.shadowColor = '#00ff66';
        context.beginPath();
        context.arc(this.x, this.y, this.size, 0, Math.PI * 2);
        context.fill();
        context.restore();
      }
    }

    // Initialize particles
    for (let i = 0; i < 40; i++) {
      particles.push(new HeartParticle());
    }

    // Render loop for the nested Black and Green Heart lines
    function drawHeart() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      const centerX = canvas.width / 2;
      const centerY = canvas.height / 2 + 10;
      
      // Pulse animation effect
      const pulseSpeed = isUnlocked ? 4 : 2;
      const pulse = Math.sin(time * pulseSpeed) * 0.05 + 1;
      const baseScale = (size / 34) * pulse;

      // Draw Concentric / Nested lines (Black & Green alternating layers)
      const layersCount = 22; // Number of nested heart outlines

      for (let i = layersCount; i >= 1; i--) {
        const layerRatio = i / layersCount;
        const currentScale = baseScale * layerRatio;
        
        ctx.beginPath();
        
        // Render detailed heart path using smooth steps
        const steps = 180;
        for (let j = 0; j <= steps; j++) {
          const t = (j / steps) * Math.PI * 2;
          const pt = getHeartPoint(t, currentScale);
          const px = centerX + pt.x;
          const py = centerY + pt.y;

          if (j === 0) {
            ctx.moveTo(px, py);
          } else {
            ctx.lineTo(px, py);
          }
        }
        ctx.closePath();

        // Alternate colors: Green (#00ff66) vs Black (#000000)
        const isGreen = (i % 2 === 0);
        
        if (isGreen) {
          ctx.strokeStyle = '#00ff66';
          ctx.lineWidth = 2.5;
          ctx.shadowColor = '#00ff66';
          ctx.shadowBlur = isUnlocked ? 15 : 8;
        } else {
          // Pure Black contour with dark green back-glow to stand out on dark bg
          ctx.strokeStyle = '#000000';
          ctx.lineWidth = 4;
          ctx.shadowColor = '#02240f';
          ctx.shadowBlur = 4;
        }

        ctx.stroke();
      }

      // Draw center core heart glow
      ctx.save();
      ctx.beginPath();
      for (let j = 0; j <= 100; j++) {
        const t = (j / 100) * Math.PI * 2;
        const pt = getHeartPoint(t, baseScale * 0.15);
        if (j === 0) ctx.moveTo(centerX + pt.x, centerY + pt.y);
        else ctx.lineTo(centerX + pt.x, centerY + pt.y);
      }
      ctx.closePath();
      ctx.fillStyle = '#00ff66';
      ctx.shadowColor = '#00ff66';
      ctx.shadowBlur = 25;
      ctx.fill();
      ctx.restore();

      // Render floating green particles
      particles.forEach(p => {
        p.update();
        p.draw(ctx);
      });

      time += 0.03;
      requestAnimationFrame(drawHeart);
    }

    // Start Animation on Load
    window.onload = function() {
      drawHeart();
    };

    /* ==========================================
       PASSWORD & UNLOCK LOGIC
       ========================================== */
    const CORRECT_PASSWORD = "13123"; // Default Password updated to 13123

    function handleUnlock(event) {
      event.preventDefault();
      const input = document.getElementById('passwordInput');
      const lockCard = document.getElementById('lockCard');
      const messageCard = document.getElementById('messageCard');
      const errorMsg = document.getElementById('errorMessage');

      if (input.value.trim() === CORRECT_PASSWORD) {
        // Success Logic
        errorMsg.classList.add('hidden');
        isUnlocked = true;
        playToneSequence();

        // Smooth transition out for form
        lockCard.style.opacity = '0';
        lockCard.style.transform = 'scale(0.9)';

        setTimeout(() => {
          lockCard.classList.add('hidden');
          
          // Reveal message card
          messageCard.classList.remove('hidden');
          setTimeout(() => {
            messageCard.classList.remove('opacity-0', 'scale-90');
            messageCard.classList.add('opacity-100', 'scale-100');
          }, 50);
        }, 400);

      } else {
        // Error Logic
        errorMsg.classList.remove('hidden');
        lockCard.classList.remove('animate-shake');
        // Trigger reflow to restart animation
        void lockCard.offsetWidth;
        lockCard.classList.add('animate-shake');
        
        // Reset input focus & clear
        input.value = '';
        input.focus();
      }
    }

    function lockAgain() {
      const lockCard = document.getElementById('lockCard');
      const messageCard = document.getElementById('messageCard');
      const input = document.getElementById('passwordInput');
      
      isUnlocked = false;
      input.value = '';

      messageCard.classList.remove('opacity-100', 'scale-100');
      messageCard.classList.add('opacity-0', 'scale-90');

      setTimeout(() => {
        messageCard.classList.add('hidden');
        lockCard.classList.remove('hidden');
        setTimeout(() => {
          lockCard.style.opacity = '1';
          lockCard.style.transform = 'scale(1)';
        }, 50);
      }, 400);
    }

    function togglePasswordVisibility() {
      const input = document.getElementById('passwordInput');
      if (input.type === 'password') {
        input.type = 'text';
      } else {
        input.type = 'password';
      }
    }

    /* Web Audio API Sound Feedback (Pure Synth sound on Unlock) */
    function playToneSequence() {
      try {
        const AudioContext = window.AudioContext || window.webkitAudioContext;
        if (!AudioContext) return;
        const audioCtx = new AudioContext();
        
        const notes = [523.25, 659.25, 783.99, 1046.50]; // C5, E5, G5, C6
        notes.forEach((freq, index) => {
          const osc = audioCtx.createOscillator();
          const gain = audioCtx.createGain();
          
          osc.type = 'sine';
          osc.frequency.setValueAtTime(freq, audioCtx.currentTime + index * 0.1);
          
          gain.gain.setValueAtTime(0.1, audioCtx.currentTime + index * 0.1);
          gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + index * 0.1 + 0.3);
          
          osc.connect(gain);
          gain.connect(audioCtx.destination);
          
          osc.start(audioCtx.currentTime + index * 0.1);
          osc.stop(audioCtx.currentTime + index * 0.1 + 0.3);
        });
      } catch (e) {
        // Audio context play blocked or unsupported silently handled
      }
    }

    // Responsive Canvas Resizing
    window.addEventListener('resize', () => {
      const newSize = Math.min(window.innerWidth - 32, 380);
      canvas.width = newSize;
      canvas.height = newSize;
    });
  </script>
</body>
</html>
